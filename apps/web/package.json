{
  "name": "@apetite/web",
  "version": "0.1.0",
  "private": true,
  "description": "React + Vite веб-версия: лендинг, вход, карта предложений, оплата и заказы.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@apetite/shared": "workspace:*",
    "leaflet": "1.9.4",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "1.9.22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^5.0.1"
  }
}
