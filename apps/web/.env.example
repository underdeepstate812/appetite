# Vite инлайнит переменные с префиксом VITE_ в бандл на этапе сборки.
# Скопируй: cp .env.example .env

VITE_API_BASE_URL=http://localhost:3000/api/v1

# Ключ Яндекс.Карт (JS API 3.0). Без него рабочая карта — запасная на OpenStreetMap.
# Получить: developer.tech.yandex.ru -> "Кабинет разработчика" -> "Подключить API" -> "JavaScript API и HTTP Геокодер".
# Ограничьте ключ по HTTP-реферреру своими доменами (для туннелей на время тестов можно снять ограничение).
# VITE_YANDEX_MAPS_API_KEY=
