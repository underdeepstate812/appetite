generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  BUSINESS
  ADMIN
}

enum OfferCategory {
  FOOD
  BAKERY
  FLOWERS
  GROCERIES
}

/// DYNAMIC — скидка растёт к концу самовывоза (стартовая + 10% за 2 ч, + 20% за час, максимум 70%); FIXED — всё время равна стартовой.
enum DiscountMode {
  DYNAMIC
  FIXED
}

enum OfferStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  ARCHIVED
}

/// CONFIRMED — оплачен (mock), ожидает самовывоза.
/// COMPLETED — забран пользователем, начислены эко-баллы.
/// CANCELLED — отменён пользователем до окончания pickup-окна, quantityLeft возвращается.
/// EXPIRED — не выкуплен до pickupEnd, переводится шедулером, quantityLeft не возвращается.
enum ReceiptDisputeReason {
  NOT_RECEIVED
  WRONG_ITEM
  QUALITY
  OTHER
}

enum OrderStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum NotificationType {
  NEARBY_OFFERS
  PICKUP_REMINDER
  ORDER_CONFIRMED
  ORDER_COMPLETED
  ORDER_EXPIRED
  ORDER_CANCELLED
  /// Покупатель оспорил получение заказа — админам платформы и заведению.
  RECEIPT_DISPUTED
  /// Новый заказ — заведению, сразу после оплаты. Триггер для "Принять заказ" в панели бизнеса.
  ORDER_RECEIVED
  /// Заведение подтвердило заказ — покупателю. С этого момента отменить заказ уже нельзя.
  ORDER_ACCEPTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  phone            String?  @unique
  name             String
  /// Относительный путь вида /uploads/avatars/<uuid>.<ext> — отдаётся статикой backend.
  avatarUrl        String?
  role             Role     @default(USER)
  refreshTokenHash String?
  /// Expo push-токен устройства (ШАГ 6/9) — одно устройство на аккаунт, достаточно для беты.
  expoPushToken    String?
  /// Последняя известная геопозиция — обновляется мобильным приложением (ШАГ 9),
  /// используется гео-триггером "рядом с тобой N предложений".
  lastLat          Float?
  lastLng          Float?
  /// Радиус в км, в котором пользователь хочет получать гео-уведомления.
  notifyRadiusKm   Float    @default(5)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  businesses      Business[]
  orders          Order[]
  ecoTransactions EcoTransaction[]
  notifications   Notification[]

  @@index([role])
  @@index([lastLat, lastLng])
  @@map("users")
}

model Business {
  id                String         @id @default(uuid())
  ownerUserId       String
  owner             User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  /// Основная категория заведения — для витрины/фильтров; офферы могут иметь свою category.
  category          OfferCategory
  address           String
  lat               Float
  lng               Float
  status            BusinessStatus @default(PENDING)
  /// % комиссии платформы для этого заведения (по умолчанию — платформенная константа).
  /// Фактически не взимается, пока не истёк пробный период — см. trialEndsAt.
  commissionPercent Int            @default(25)
  /// Логотип заведения — опционально, до загрузки показывается плейсхолдер с инициалом.
  logoUrl           String?
  /// Снимок PlatformSettings.trialPeriodDays на момент онбординга (createdAt + N дней) —
  /// не пересчитывается задним числом при смене глобальной настройки. Пока now() < trialEndsAt,
  /// orders.service.ts начисляет комиссию 0% независимо от commissionPercent (бизнес-модель:
  /// бесплатное подключение на старте, см. апробировано в оферте/FAQ на сайте).
  trialEndsAt       DateTime?
  /// Часовой пояс заведения (IANA): по нему читаются часы работы и считаются «сутки» на витрине.
  timezone          String         @default("Europe/Moscow")
  /// Часы работы: {"1": {"open": "10:00", "close": "22:00"}, …, "7": null} (ключ — ISO-день недели, null — выходной).
  /// Самовывоз любого оффера обязан целиком уложиться в рабочий интервал (см. shared/working-hours.ts). null — не заданы.
  workingHours      Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  offers Offer[]
  schedules OfferSchedule[]
  orders Order[]

  @@index([ownerUserId])
  @@index([status])
  @@index([lat, lng])
  @@map("businesses")
}

model Offer {
  id              String        @id @default(uuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  category        OfferCategory
  /// Минорные единицы валюты (копейки), Int — без ошибок округления float.
  originalPrice   Int
  /// Пересчитывается шедулером каждые 15 минут (ШАГ 5).
  discountedPrice Int
  discountPercent Int           @default(50)
  /// Стартовая скидка, которую задаёт владелец бизнеса при создании оффера (минимум 25%).
  baseDiscountPercent Int       @default(50)
  /// Фото товара — опционально, до загрузки показывается плейсхолдер по категории.
  imageUrl        String?
  quantityTotal   Int
  quantityLeft    Int
  /// Вес одной единицы товара, кг — основа для эко-баллов и "спасённых кг".
  weightKg        Float
  pickupStart     DateTime
  pickupEnd       DateTime
  status          OfferStatus   @default(ACTIVE)
  /// Режим скидки; шедулер пересчитывает только DYNAMIC-офферы.
  discountMode    DiscountMode  @default(DYNAMIC)
  /// Оффер выложен автоматически по этому шаблону (null — вручную). Шаблон удалили — оффер остаётся.
  scheduleId      String?
  schedule        OfferSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  /// Локальная дата выкладки «YYYY-MM-DD» — вместе со scheduleId даёт идемпотентность: один оффер на шаблон и дату.
  occurrenceDate  String?
  /// «Горячее предложение дня»: витрина показывает его самым горячим и первым независимо от оставшегося времени
  /// (обычный «жар» считается по времени до конца окна, а у суточного оффера он всегда нулевой).
  featured        Boolean       @default(false)
  /// Состав — обязателен для еды/выпечки/продуктов (до оплаты покупатель должен его видеть).
  ingredients     String?
  /// Коды аллергенов (OFFER_ALLERGENS из @apetite/shared).
  allergens       String[]      @default([])
  /// Заведение явно указало аллергены (в том числе «аллергенов нет»); false — сведений нет, у старых офферов.
  allergensDeclared Boolean     @default(false)
  /// Срок годности.
  bestBefore      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  orders Order[]

  @@unique([scheduleId, occurrenceDate])
  @@index([businessId])
  @@index([status, pickupEnd])
  @@index([category])
  @@map("offers")
}

/// Шаблон автовыкладки: позиция + расписание. Шедулер сам создаёт из него офферы (см. offer-schedules).
model OfferSchedule {
  id                  String        @id @default(uuid())
  businessId          String
  business            Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  category            OfferCategory
  /// Минорные единицы валюты (копейки).
  originalPrice       Int
  baseDiscountPercent Int           @default(50)
  discountMode        DiscountMode  @default(DYNAMIC)
  imageUrl            String?
  quantityTotal       Int
  weightKg            Float
  ingredients         String?
  allergens           String[]      @default([])
  allergensDeclared   Boolean       @default(false)
  /// Срок годности каждого оффера = конец самовывоза + столько часов.
  bestBeforeHoursAfterEnd Int?
  /// ISO-дни недели: 1 = понедельник … 7 = воскресенье.
  daysOfWeek          Int[]
  /// «HH:mm» в часовом поясе timezone; конец не позже начала — окно заканчивается на следующие сутки.
  pickupStartTime     String
  pickupEndTime       String
  /// За сколько минут до начала самовывоза оффер появляется на витрине.
  publishLeadMinutes  Int           @default(180)
  timezone            String        @default("Europe/Moscow")
  /// Границы действия «YYYY-MM-DD» (включительно).
  startsOn            String?
  endsOn              String?
  /// Даты «YYYY-MM-DD», которые пропускаем.
  skipDates           String[]      @default([])
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  offers Offer[]

  @@index([businessId])
  @@index([isActive])
  @@map("offer_schedules")
}

model Order {
  id                   String      @id @default(uuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  offerId              String
  offer                Offer       @relation(fields: [offerId], references: [id], onDelete: Restrict)
  /// Денормализовано из Offer.businessId — упрощает выборки "заказы моего заведения" без join через Offer.
  businessId           String
  business             Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  quantity             Int
  totalPrice           Int
  platformFee          Int
  status               OrderStatus @default(CONFIRMED)
  /// PIN самовывоза — показывается пользователю, сверяется заведением при выдаче.
  pickupCode           String      @unique
  createdAt            DateTime    @default(now())
  /// Момент, когда заведение подтвердило заказ (см. "Принять заказ" в панели бизнеса) —
  /// до этого пользователь ещё может отменить (orders.service.ts cancel()), после — уже нет.
  acceptedAt           DateTime?
  completedAt          DateTime?
  /// Когда отправлено напоминание "забери за 30 минут" — чтобы шедулер не слал повторно.
  pickupReminderSentAt DateTime?
  /// Покупатель подтвердил, что получил заказ, — после того как заведение отметило выдачу (completedAt).
  receiptConfirmedAt   DateTime?
  /// Покупатель сообщил, что заказ не получен/получен не так; спор разбирает платформа.
  receiptDisputedAt    DateTime?
  receiptDisputeReason ReceiptDisputeReason?
  receiptDisputeNote   String?

  ecoTransaction EcoTransaction?
  payment        Payment?

  @@index([userId])
  @@index([businessId])
  @@index([status, createdAt])
  @@index([receiptDisputedAt])
  @@map("orders")
}

/// Mock-платёж (ШАГ 5) за интерфейсом, совместимым по форме со Stripe/СБП —
/// провайдер меняется через DI-токен PAYMENT_PROVIDER, эта модель не завязана на mock.
model Payment {
  id         String        @id @default(uuid())
  orderId    String        @unique
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   String
  /// id платежа во внешней системе (у mock — сгенерированный, у Stripe/СБП — их id).
  externalId String        @unique
  amount     Int
  currency   String        @default("RUB")
  status     PaymentStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
  @@map("payments")
}

model EcoTransaction {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  points        Int
  /// Offer.weightKg * Order.quantity
  weightSavedKg Float
  createdAt     DateTime @default(now())

  @@index([userId])
  @@map("eco_transactions")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@map("notifications")
}

enum BusinessApplicationStatus {
  NEW
  REVIEWED
}

/// Заявка на подключение с публичной формы (веб-лендинг, "Для бизнеса") — НЕ создаёт
/// аккаунт/заведение напрямую (само-регистрация бизнесов вне скоупа беты, ШАГ 0),
/// только фиксирует лид с принятой офертой для ручного онбординга админом.
model BusinessApplication {
  id             String                     @id @default(uuid())
  name           String
  category       OfferCategory
  address        String
  contactName    String
  contactEmail   String
  contactPhone   String
  /// Пользователь поставил галочку согласия с публичной офертой — обязательное условие подачи.
  ofertaAccepted Boolean                    @default(false)
  status         BusinessApplicationStatus  @default(NEW)
  createdAt      DateTime                   @default(now())

  @@index([status])
  @@map("business_applications")
}

/// Синглтон-строка (id всегда 1) — платформенные настройки, редактируемые из admin,
/// а не заданные на деплое через .env (в отличие от остального конфига в env.validation.ts):
/// это бизнес-параметр, который платформа регулирует сама по ходу пилота (ШАГ 0 брифа).
model PlatformSettings {
  id              Int      @id @default(1)
  /// Сколько дней после онбординга заведение не платит комиссию (platformFee = 0 на
  /// orders.service.ts). Снимок берётся в Business.trialEndsAt в момент онбординга.
  trialPeriodDays Int      @default(25)
  updatedAt       DateTime @updatedAt

  @@map("platform_settings")
}
