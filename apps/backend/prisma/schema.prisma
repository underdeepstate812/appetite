generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  BUSINESS
  ADMIN
}

enum OfferCategory {
  FOOD
  BAKERY
  FLOWERS
  GROCERIES
}

enum OfferStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  ARCHIVED
}

/// CONFIRMED — оплачен (mock), ожидает самовывоза.
/// COMPLETED — забран пользователем, начислены эко-баллы.
/// CANCELLED — отменён пользователем до окончания pickup-окна, quantityLeft возвращается.
/// EXPIRED — не выкуплен до pickupEnd, переводится шедулером, quantityLeft не возвращается.
enum OrderStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum NotificationType {
  NEARBY_OFFERS
  PICKUP_REMINDER
  ORDER_CONFIRMED
  ORDER_COMPLETED
  ORDER_EXPIRED
  ORDER_CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  phone            String?  @unique
  name             String
  role             Role     @default(USER)
  refreshTokenHash String?
  /// Expo push-токен устройства (ШАГ 6/9) — одно устройство на аккаунт, достаточно для беты.
  expoPushToken    String?
  /// Последняя известная геопозиция — обновляется мобильным приложением (ШАГ 9),
  /// используется гео-триггером "рядом с тобой N предложений".
  lastLat          Float?
  lastLng          Float?
  /// Радиус в км, в котором пользователь хочет получать гео-уведомления.
  notifyRadiusKm   Float    @default(5)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  businesses      Business[]
  orders          Order[]
  ecoTransactions EcoTransaction[]
  notifications   Notification[]

  @@index([role])
  @@index([lastLat, lastLng])
  @@map("users")
}

model Business {
  id                String         @id @default(uuid())
  ownerUserId       String
  owner             User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  /// Основная категория заведения — для витрины/фильтров; офферы могут иметь свою category.
  category          OfferCategory
  address           String
  lat               Float
  lng               Float
  status            BusinessStatus @default(PENDING)
  /// % комиссии платформы для этого заведения (по умолчанию — платформенная константа).
  commissionPercent Int            @default(25)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  offers Offer[]
  orders Order[]

  @@index([ownerUserId])
  @@index([status])
  @@index([lat, lng])
  @@map("businesses")
}

model Offer {
  id              String        @id @default(uuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  category        OfferCategory
  /// Минорные единицы валюты (копейки), Int — без ошибок округления float.
  originalPrice   Int
  /// Пересчитывается шедулером каждые 15 минут (ШАГ 5).
  discountedPrice Int
  discountPercent Int           @default(50)
  quantityTotal   Int
  quantityLeft    Int
  /// Вес одной единицы товара, кг — основа для эко-баллов и "спасённых кг".
  weightKg        Float
  pickupStart     DateTime
  pickupEnd       DateTime
  status          OfferStatus   @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  orders Order[]

  @@index([businessId])
  @@index([status, pickupEnd])
  @@index([category])
  @@map("offers")
}

model Order {
  id                   String      @id @default(uuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  offerId              String
  offer                Offer       @relation(fields: [offerId], references: [id], onDelete: Restrict)
  /// Денормализовано из Offer.businessId — упрощает выборки "заказы моего заведения" без join через Offer.
  businessId           String
  business             Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  quantity             Int
  totalPrice           Int
  platformFee          Int
  status               OrderStatus @default(CONFIRMED)
  /// PIN самовывоза — показывается пользователю, сверяется заведением при выдаче.
  pickupCode           String      @unique
  createdAt            DateTime    @default(now())
  completedAt          DateTime?
  /// Когда отправлено напоминание "забери за 30 минут" — чтобы шедулер не слал повторно.
  pickupReminderSentAt DateTime?

  ecoTransaction EcoTransaction?
  payment        Payment?

  @@index([userId])
  @@index([businessId])
  @@index([status, createdAt])
  @@map("orders")
}

/// Mock-платёж (ШАГ 5) за интерфейсом, совместимым по форме со Stripe/СБП —
/// провайдер меняется через DI-токен PAYMENT_PROVIDER, эта модель не завязана на mock.
model Payment {
  id         String        @id @default(uuid())
  orderId    String        @unique
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   String
  /// id платежа во внешней системе (у mock — сгенерированный, у Stripe/СБП — их id).
  externalId String        @unique
  amount     Int
  currency   String        @default("RUB")
  status     PaymentStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status])
  @@map("payments")
}

model EcoTransaction {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  points        Int
  /// Offer.weightKg * Order.quantity
  weightSavedKg Float
  createdAt     DateTime @default(now())

  @@index([userId])
  @@map("eco_transactions")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@map("notifications")
}
