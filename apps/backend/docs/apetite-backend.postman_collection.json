            "method": "GET",
            "url": { "raw": "{{baseUrl}}/businesses", "host": ["{{baseUrl}}"], "path": ["businesses"] }
          }
        },
        {
          "name": "Create business (ADMIN — ручной онбординг)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('businessId', data.id);",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerEmail\": \"postman-owner@apetite.ru\",\n  \"ownerPassword\": \"password123\",\n  \"ownerName\": \"Postman Owner\",\n  \"name\": \"Postman Test Cafe\",\n  \"category\": \"FOOD\",\n  \"address\": \"ул. Примерная, 1\",\n  \"lat\": 55.75,\n  \"lng\": 37.62\n}"
            },
            "url": { "raw": "{{baseUrl}}/businesses", "host": ["{{baseUrl}}"], "path": ["businesses"] }
          }
        },
        {
          "name": "My business (BUSINESS)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{businessAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/businesses/mine", "host": ["{{baseUrl}}"], "path": ["businesses", "mine"] }
          }
        },
        {
          "name": "Update business (owner)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Обновлено через Postman\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/businesses/{{businessId}}",
              "host": ["{{baseUrl}}"],
              "path": ["businesses", "{{businessId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Offers",
      "item": [
        {
          "name": "List offers (public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/offers?page=1&pageSize=20", "host": ["{{baseUrl}}"], "path": ["offers"], "query": [
              { "key": "page", "value": "1" },
              { "key": "pageSize", "value": "20" }
            ] }
          }
        },
        {
          "name": "Create offer (BUSINESS, под своим заведением)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('offerId', data.id);",
                  "pm.test('201 Created, скидка 50% посчитана', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(data.discountPercent).to.eql(50);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{businessAccessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessId\": \"{{businessId}}\",\n  \"title\": \"Postman тест-оффер\",\n  \"category\": \"FOOD\",\n  \"originalPriceRub\": 500,\n  \"weightKg\": 0.5,\n  \"quantityTotal\": 5,\n  \"pickupStart\": \"2026-01-01T10:00:00.000Z\",\n  \"pickupEnd\": \"2026-01-01T20:00:00.000Z\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/offers", "host": ["{{baseUrl}}"], "path": ["offers"] }
          },
          "description": "Замени businessId на id своего заведения из шага 'My business', если запускаешь не по порядку. pickupStart/pickupEnd поставь на будущее."
        },
        {
          "name": "Nearby offers (гео-поиск, публично)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/offers/nearby?lat=55.751244&lng=37.618423&radiusKm=10&category=FOOD&minDiscount=0",
              "host": ["{{baseUrl}}"],
              "path": ["offers", "nearby"],
              "query": [
                { "key": "lat", "value": "55.751244" },
                { "key": "lng", "value": "37.618423" },
                { "key": "radiusKm", "value": "10" },
                { "key": "category", "value": "FOOD" },
                { "key": "minDiscount", "value": "0" }
              ]
            },
            "description": "Haversine-поиск (ШАГ 5). category/minDiscount необязательны. Координаты по умолчанию — центр Москвы."
          }
        },
        {
          "name": "Get offer",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/offers/{{offerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["offers", "{{offerId}}"]
            }
          }
        },
        {
          "name": "Update offer price (owner)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{businessAccessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"originalPriceRub\": 450\n}" },
            "url": {
              "raw": "{{baseUrl}}/offers/{{offerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["offers", "{{offerId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order (USER покупает offerId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('orderId', data.id);",
                  "pm.collectionVariables.set('pickupCode', data.pickupCode);",
                  "pm.test('201 Created, статус CONFIRMED, mock-оплата и QR приложены', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(data.status).to.eql('CONFIRMED');",
                  "  pm.expect(data.qrCodeDataUrl).to.match(/^data:image\\/png;base64,/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userAccessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"offerId\": \"{{offerId}}\",\n  \"quantity\": 1\n}" },
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
          }
        },
        {
          "name": "List my orders (USER)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
          }
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}"] }
          }
        },
        {
          "name": "Get QR code (повторно)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userAccessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/qrcode",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "qrcode"]
            },
            "description": "QR кодирует {orderId, pickupCode} — тем же кодом, что вернул Create order."
          }
        },
        {
          "name": "Complete pickup (BUSINESS, по pickupCode)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('статус COMPLETED', () => pm.expect(pm.response.json().status).to.eql('COMPLETED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{businessAccessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"pickupCode\": \"{{pickupCode}}\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "complete"]
            }
          }
        },
        {
          "name": "Cancel order (USER, пример на новый заказ)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{userAccessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "cancel"]
            },
            "description": "Сработает только если заказ ещё CONFIRMED — если перед этим выполнил Complete pickup выше, создай новый Order и подставь его id."
          }
        }
      ]
    },
    {
      "name": "Scheduler (ШАГ 5)",
      "item": [
        {
          "name": "Run discount recalculation (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK со сводкой', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const d = pm.response.json();",
                  "  pm.expect(d).to.have.property('offersRecalculated');",
                  "  pm.expect(d).to.have.property('ordersExpired');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/scheduler/run-discounts", "host": ["{{baseUrl}}"], "path": ["scheduler", "run-discounts"] }
          },
          "description": "Ручной запуск того же кода, что выполняется по крону каждые 15 минут (DISCOUNT_CRON_EXPRESSION): пересчёт скидок ACTIVE-офферов + перевод CONFIRMED-заказов с истёкшим pickupEnd в EXPIRED."
        }
      ]
    },
    {
      "name": "Payments (ШАГ 5)",
      "item": [
        {
          "name": "Webhook — simulate provider callback",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Подпись = HMAC-SHA256('{externalId}.{status}', PAYMENT_WEBHOOK_SECRET) — тот же",
                  "// контракт, что потребуется для настоящего Stripe/СБП-вебхука при замене провайдера.",
                  "const externalId = pm.collectionVariables.get('paymentExternalId');",
                  "const status = 'SUCCEEDED';",
                  "const secret = pm.collectionVariables.get('webhookSecret');",
                  "const signature = CryptoJS.HmacSHA256(`${externalId}.${status}`, secret).toString();",
                  "pm.collectionVariables.set('_webhookSignature', signature);",
                  "pm.request.body.update(JSON.stringify({ externalId, status }));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-webhook-signature", "value": "{{_webhookSignature}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"externalId\": \"{{paymentExternalId}}\",\n  \"status\": \"SUCCEEDED\"\n}" },
            "url": { "raw": "{{baseUrl}}/payments/webhook", "host": ["{{baseUrl}}"], "path": ["payments", "webhook"] }
          },
          "description": "У mock-провайдера оплата уже синхронно успешна при создании заказа — этот запрос лишь демонстрирует контракт вебхука. Перед запуском вручную подставь переменную paymentExternalId (достань из таблицы payments: SELECT \"externalId\" FROM payments ORDER BY \"createdAt\" DESC LIMIT 1) — API его не возвращает."
        }
      ]
    },
    {
      "name": "Notifications & Geo (ШАГ 6)",
      "item": [
        {
          "name": "Register push token (USER)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userAccessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"ExponentPushToken[postman-demo-token]\"\n}" },
            "url": { "raw": "{{baseUrl}}/notifications/push-token", "host": ["{{baseUrl}}"], "path": ["notifications", "push-token"] }
          }
        },
        {
          "name": "Update my location (USER)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userAccessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"lat\": 55.751244,\n  \"lng\": 37.618423\n}" },
            "url": { "raw": "{{baseUrl}}/users/me/location", "host": ["{{baseUrl}}"], "path": ["users", "me", "location"] }
          },
          "description": "То, что вызовет мобильное приложение при выдаче геопермишена (ШАГ 9) — центр Москвы, чтобы гео-дайджест сразу нашёл сидовые заведения."
        },
        {
          "name": "Run notifications digest (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK со сводкой', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const d = pm.response.json();",
                  "  pm.expect(d).to.have.property('nearbyDigestsSent');",
                  "  pm.expect(d).to.have.property('pickupRemindersSent');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/notifications/run-digest", "host": ["{{baseUrl}}"], "path": ["notifications", "run-digest"] }
          },
          "description": "Ручной запуск того же кода, что выполняется по крону: гео-дайджест 'рядом с тобой N предложений' (throttle 3ч на пользователя) + напоминания за 30 минут до pickupEnd (по одному на заказ)."
        },
        {
          "name": "List my notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.items && data.items.length > 0) {",
                  "  pm.collectionVariables.set('notificationId', data.items[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userAccessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/notifications?unreadOnly=false&page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"],
              "query": [
                { "key": "unreadOnly", "value": "false" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Mark notification read",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{userAccessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/notifications/{{notificationId}}/read",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "{{notificationId}}", "read"]
            }
          }
        }
      ]
    }
  ]
}
