{
  "info": {
    "name": "Apetite Backend — ШАГ 4+5+6",
    "description": "Auth, Business/Offer/Order CRUD (ШАГ 4) + гео-поиск, mock-оплата/QR/эко-баллы, шедулер скидок, вебхук платежей (ШАГ 5) + push-токен, геопозиция, гео-дайджест и напоминания о самовывозе (ШАГ 6). Импортируй в Postman, выполняй по порядку сверху вниз — тесты каждого запроса сохраняют id/токены в переменные коллекции для следующих запросов.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "userAccessToken", "value": "" },
    { "key": "userRefreshToken", "value": "" },
    { "key": "businessAccessToken", "value": "" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "businessId", "value": "" },
    { "key": "offerId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "pickupCode", "value": "" },
    { "key": "webhookSecret", "value": "change-me-webhook-secret" },
    { "key": "paymentExternalId", "value": "" },
    { "key": "notificationId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as demo user (user@apetite.ru)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('userAccessToken', data.accessToken);",
                  "pm.collectionVariables.set('userRefreshToken', data.refreshToken);",
                  "pm.test('200 OK с токенами', () => { pm.response.to.have.status(200); pm.expect(data.accessToken).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@apetite.ru\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login as business owner (cafe.pushkin@apetite.ru)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('businessAccessToken', data.accessToken);",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cafe.pushkin@apetite.ru\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login as admin (admin@apetite.ru)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('adminAccessToken', data.accessToken);",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@apetite.ru\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Register new user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman-demo@apetite.ru\",\n  \"password\": \"password123\",\n  \"name\": \"Postman Demo\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
