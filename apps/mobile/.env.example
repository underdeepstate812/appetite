# Expo инлайнит переменные с префиксом EXPO_PUBLIC_ в бандл на этапе сборки —
# файл должен лежать именно в apps/mobile/ (Metro не читает корневой .env монорепо).
# Скопируй: cp .env.example .env

# Для эмулятора/симулятора — localhost. Для физического устройства в одной Wi-Fi
# сети с компьютером — замени на IP компьютера в локальной сети (напр. http://192.168.1.50:3000/api/v1).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
