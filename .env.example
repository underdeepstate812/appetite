# =====================================================================
# Apetite — переменные окружения (пример). Скопируй в .env и заполни.
# Используется docker-compose (ШАГ 2) и apps/backend (ШАГ 4+).
# =====================================================================

# --- Общее ---
NODE_ENV=development
TZ=Europe/Moscow

# --- PostgreSQL ---
POSTGRES_USER=apetite
POSTGRES_PASSWORD=apetite
POSTGRES_DB=apetite
POSTGRES_PORT=5432
DATABASE_URL=postgresql://apetite:apetite@localhost:5432/apetite?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Backend (NestJS) ---
BACKEND_PORT=3000
API_PREFIX=api/v1

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d

# --- Платежи (mock-провайдер, интерфейс под Stripe/СБП) ---
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

# --- Push (Expo Notifications, mock в dev) ---
EXPO_PUSH_MODE=mock
EXPO_ACCESS_TOKEN=

# --- Платформенные настройки ---
PLATFORM_COMMISSION_PERCENT=25
PICKUP_CODE_LENGTH=6

# --- Discount scheduler ---
DISCOUNT_CRON_EXPRESSION="*/15 * * * *"

# --- Admin (React + Vite) ---
ADMIN_PORT=5173
VITE_API_BASE_URL=http://localhost:3000/api/v1

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
