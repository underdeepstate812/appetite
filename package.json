{
  "name": "apetite",
  "version": "0.1.0",
  "private": true,
  "description": "Apetite — витрина горячих послеобеденных предложений со скидками 50–70% на еду, цветы и товары из кафе, ресторанов и магазинов.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build:shared": "pnpm --filter @apetite/shared run build",
    "dev:backend": "pnpm --filter @apetite/backend dev",
    "dev:admin": "pnpm --filter @apetite/admin dev",
    "dev:web": "pnpm --filter @apetite/web dev",
    "dev:mobile": "pnpm --filter @apetite/mobile start",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "db:migrate": "pnpm --filter @apetite/backend prisma:migrate",
    "db:deploy": "pnpm --filter @apetite/backend prisma:deploy",
    "db:seed": "pnpm --filter @apetite/backend prisma:seed",
    "db:studio": "pnpm --filter @apetite/backend prisma:studio",
    "backup": "bash scripts/backup.sh"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.4.0",
      "shell-quote": "^1.11.0",
      "source-map-js": "^1.2.2",
      "uuid": "^11.1.1",
      "deepmerge-ts": "^8.0.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-hp3w-g68c-fv3c"
      ]
    }
  }
}
